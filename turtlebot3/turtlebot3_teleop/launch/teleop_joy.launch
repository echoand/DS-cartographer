<launch>
    <!-- 启动手柄节点，respawn="true"表示节点挂掉时会自动重启 -->
    <node pkg="joy" type="joy_node" name="joystick" respawn="true"/>

    <!-- 启动我们创建的手柄控制乌龟节点 -->
    <node pkg="turtlebot3_joy" type="teleop_joy" name="teleop_joy" output="screen">
        <!-- 向参数服务器写入参数 -->
        <!-- <param name="axis_linear" value="1"/>
        <param name="axis_angular" value="0"/>
        <param name="scale_linear" value="0.5"/>
        <param name="scale_angular" value="1.5"/> -->

        <param name="axis_linear"   type="int"      value="1" />
        <param name="axis_angular"  type="int"      value="0"/>
        <param name="vlinear"       type="double"   value="0.3" />
        <param name="vangular"      type="double"   value="1"/>
        <param name="enable_button" value="0"/>
    </node>
</launch>
